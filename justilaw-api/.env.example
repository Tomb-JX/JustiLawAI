# 复制为 .env 后按需修改（.env 不入库）

# Ollama 地址（不要填 0.0.0.0，那是监听地址）
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 默认模型（平台模型 ID；也可在前端「模型服务」页修改）
DEFAULT_CHAT_MODEL=ollama/qwen3.5:9b
DEFAULT_EMBED_MODEL=ollama/bge-m3

# Logto 鉴权：两项都填才启用 JWT 校验；留空为单用户本地模式
# LOGTO_API_RESOURCE 须与前端 VITE_LOGTO_RESOURCE 一致
LOGTO_ENDPOINT=
LOGTO_API_RESOURCE=
# 管理员的 Logto 用户 ID（sub），逗号分隔
ADMIN_SUBS=
