<!--
    DeepSeek Harness 风格色板 · 深色

    与 Themes/Light.xaml 键名一一对应，只有取值不同。取值同样抄 DSH 的
    body[data-ds-dark-theme] 令牌（下面统一省掉前缀 dsw- 的连字符）：

        Bg / StreamBg   <- alias-bg-base              bluish-950 rgb(21,21,23)
        Panel           <- alias-bg-layer-1           bluish-875 rgb(35,35,36)
        PanelAlt        <- alias-bg-layer-2           bluish-850 rgb(44,44,46)
        Sidebar         <- specific-sidebar-fill      bluish-900 rgb(27,27,28)
        Line/LineStrong <- border-l2 / l4 = rgba(255,255,255,.12) / (.2) 压在 bg-base 上
        Ink/Soft/Faint  <- label-primary/secondary/tertiary
        Accent          <- alias-button-primary-fill  深色下是近白
        Focus           <- static-deepseek-400        焦点环才是蓝的

    本字典必须在 ThemesDictionary / ControlsDictionary 之后合并，否则覆盖不生效。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= 颜色 ================= -->
    <!-- 窗口底色（卡片之间的缝隙）。比卡片深一档，卡片才浮得起来。 -->
    <Color x:Key="BackdropColor">#0E0E10</Color>
    <Color x:Key="BgColor">#151517</Color>
    <Color x:Key="PanelColor">#232324</Color>
    <Color x:Key="PanelAltColor">#2C2C2E</Color>
    <Color x:Key="SidebarColor">#1B1B1C</Color>
    <Color x:Key="StreamBgColor">#151517</Color>
    <!-- 用户消息气泡：DSH 的 specific-bubble，深色下 = bluish-850 -->
    <Color x:Key="BubbleColor">#2C2C2E</Color>
    <Color x:Key="FillColor">#2C2C2E</Color>
    <Color x:Key="FillHoverColor">#3C3C3D</Color>
    <Color x:Key="LineColor">#313133</Color>
    <Color x:Key="LineStrongColor">#444446</Color>
    <Color x:Key="InkColor">#F9FAFB</Color>
    <Color x:Key="InkSoftColor">#CFD3D6</Color>
    <Color x:Key="InkFaintColor">#ADB2B8</Color>
    <!-- 主按钮底色：DSH 深色下用的是近白（bluish-50），不是强调蓝 -->
    <Color x:Key="AccentColor">#F9FAFB</Color>
    <Color x:Key="AccentHoverColor">#EBEEF2</Color>
    <Color x:Key="AccentPressColor">#DCE0E6</Color>
    <Color x:Key="AccentSoftColor">#34415B</Color>
    <Color x:Key="AccentLineColor">#3F5B93</Color>
    <Color x:Key="OnAccentColor">#0F1115</Color>
    <!-- 强调色：DSH 的 deepseek-500。发送键、焦点环、选中高亮、进度圈都走这一支蓝 -->
    <Color x:Key="AccentSolidColor">#4176E6</Color>
    <Color x:Key="AccentSolidHoverColor">#5A88EA</Color>
    <Color x:Key="AccentSolidPressColor">#3568D4</Color>
    <Color x:Key="OnAccentSolidColor">#FFFFFF</Color>
    <!-- 焦点环：强调色本身，深色下亮一档（deepseek-400） -->
    <Color x:Key="FocusColor">#7AAAFF</Color>
    <Color x:Key="DangerColor">#F25A5A</Color>
    <Color x:Key="DangerSoftColor">#3C1F1B</Color>
    <Color x:Key="DangerLineColor">#5A2A26</Color>
    <Color x:Key="OkColor">#22C55E</Color>
    <Color x:Key="OkSoftColor">#233C2C</Color>
    <Color x:Key="WarnColor">#F59E0B</Color>
    <Color x:Key="WarnSoftColor">#27241F</Color>

    <!-- 浮层滚动条：DSH 深色用 neutral-700 / 600，折成半透明白 -->
    <Color x:Key="ScrollThumbColor">#2BFFFFFF</Color>
    <Color x:Key="ScrollThumbHoverColor">#45FFFFFF</Color>

    <!-- 浮层遮罩：DSH 的 alias-bg-mask-1 = rgba(0,0,0,.5) -->
    <Color x:Key="ScrimColor">#80000000</Color>

    <!-- ================= 本应用画刷 ================= -->
    <SolidColorBrush x:Key="Backdrop"   Color="{StaticResource BackdropColor}"/>
    <SolidColorBrush x:Key="Bg"         Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="Panel"      Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="PanelAlt"   Color="{StaticResource PanelAltColor}"/>
    <SolidColorBrush x:Key="Sidebar"    Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="StreamBg"     Color="{StaticResource StreamBgColor}"/>
    <SolidColorBrush x:Key="Bubble"     Color="{StaticResource BubbleColor}"/>

    <!-- 消息流下沿的淡出：从透明渐到窗口底色，内容再往下就化进输入区后面，
         不是被硬切一刀。高度按输入区上面 40px 左右定（见 MainWindow.xaml）。 -->
    <LinearGradientBrush x:Key="BackdropFade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#000E0E10" Offset="0"/>
        <GradientStop Color="#000E0E10" Offset="0.18"/>
        <GradientStop Color="#0E0E10"   Offset="0.44"/>
        <GradientStop Color="#0E0E10"   Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Fill"       Color="{StaticResource FillColor}"/>
    <SolidColorBrush x:Key="FillHover"  Color="{StaticResource FillHoverColor}"/>
    <SolidColorBrush x:Key="Line"       Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="LineStrong" Color="{StaticResource LineStrongColor}"/>
    <SolidColorBrush x:Key="Ink"        Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="InkSoft"    Color="{StaticResource InkSoftColor}"/>
    <SolidColorBrush x:Key="InkFaint"   Color="{StaticResource InkFaintColor}"/>
    <SolidColorBrush x:Key="Accent"     Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPress" Color="{StaticResource AccentPressColor}"/>
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="AccentLine" Color="{StaticResource AccentLineColor}"/>
    <SolidColorBrush x:Key="OnAccent"   Color="{StaticResource OnAccentColor}"/>
    <SolidColorBrush x:Key="AccentSolid"      Color="{StaticResource AccentSolidColor}"/>
    <SolidColorBrush x:Key="AccentSolidHover" Color="{StaticResource AccentSolidHoverColor}"/>
    <SolidColorBrush x:Key="AccentSolidPress" Color="{StaticResource AccentSolidPressColor}"/>
    <SolidColorBrush x:Key="OnAccentSolid"    Color="{StaticResource OnAccentSolidColor}"/>
    <SolidColorBrush x:Key="Focus"      Color="{StaticResource FocusColor}"/>
    <SolidColorBrush x:Key="Danger"     Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerSoft" Color="{StaticResource DangerSoftColor}"/>
    <SolidColorBrush x:Key="DangerLine" Color="{StaticResource DangerLineColor}"/>
    <SolidColorBrush x:Key="Ok"         Color="{StaticResource OkColor}"/>
    <SolidColorBrush x:Key="OkSoft"     Color="{StaticResource OkSoftColor}"/>
    <SolidColorBrush x:Key="Warn"       Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="WarnSoft"   Color="{StaticResource WarnSoftColor}"/>
    <SolidColorBrush x:Key="Scrim"      Color="{StaticResource ScrimColor}"/>

    <!-- 阴影用（深色下要更重一点才看得出来） -->
    <SolidColorBrush x:Key="CardShadow" Color="#40000000"/>

    <!-- 滚动条滑块 -->
    <SolidColorBrush x:Key="ScrollThumb"      Color="{StaticResource ScrollThumbColor}"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="{StaticResource ScrollThumbHoverColor}"/>

    <!-- ================= 覆盖 WPF-UI 的 Fluent 令牌 ================= -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush"              Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush"       Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush"  Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush"   Color="{StaticResource PanelAltColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="{StaticResource FillColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush"    Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush"              Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="LayerFillColorAltBrush"                  Color="{StaticResource PanelAltColor}"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"     Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush"   Color="{StaticResource PanelAltColor}"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"             Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"            Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"          Color="{StaticResource FillColor}"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"           Color="{StaticResource FillColor}"/>
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush"        Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"          Color="{StaticResource LineStrongColor}"/>
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush"        Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="ControlElevationBorderBrush"             Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"               Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"             Color="{StaticResource InkSoftColor}"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"              Color="{StaticResource InkFaintColor}"/>
    <SolidColorBrush x:Key="TextFillColorDisabledBrush"              Color="{StaticResource InkFaintColor}"/>
    <SolidColorBrush x:Key="TextFillColorInverseBrush"               Color="{StaticResource OnAccentColor}"/>
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush"          Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush"           Color="{StaticResource FillColor}"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush"            Color="{StaticResource FillColor}"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"             Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"           Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"            Color="{StaticResource AccentPressColor}"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush"         Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush"       Color="{StaticResource OnAccentColor}"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush"     Color="{StaticResource OnAccentColor}"/>
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush"              Color="{StaticResource FocusColor}"/>
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush"              Color="{StaticResource FocusColor}"/>

    <!-- ===== WPF-UI 里「派生自系统强调色」的地方，一律换成我们的强调蓝 =====
         ProgressRing（生成中的小圈）、ui:TextBox 的选中高亮、
         以及 ui:Button Appearance=Primary 系的画刷，默认都从
         SystemAccentColor 推。把这一组指到 deepseek-500 上，
         深色下比浅色亮一档（deepseek-400）才压得住底色。
         注意：主按钮（AccentColor）仍然走中性近白，那是 DSH 的做法。 -->
    <Color        x:Key="SystemAccentColor">#5A8AEA</Color>
    <Color        x:Key="SystemAccentColorLight1">#7AAAFF</Color>
    <Color        x:Key="SystemAccentColorLight2">#A9C7FF</Color>
    <Color        x:Key="SystemAccentColorLight3">#C7DBFF</Color>
    <Color        x:Key="SystemAccentColorDark1">#4176E6</Color>
    <Color        x:Key="SystemAccentColorDark2">#3568D4</Color>
    <Color        x:Key="SystemAccentColorDark3">#2C58B8</Color>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush"    Color="{StaticResource AccentSolidColor}"/>
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush"  Color="{StaticResource AccentSolidHoverColor}"/>
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush"   Color="{StaticResource AccentSolidPressColor}"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundBrush"             Color="{StaticResource AccentSolidColor}"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOverBrush"  Color="{StaticResource AccentSolidHoverColor}"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundPressedBrush"      Color="{StaticResource AccentSolidPressColor}"/>
    <SolidColorBrush x:Key="AccentButtonBorderBrush"                 Color="{StaticResource AccentSolidColor}"/>
    <SolidColorBrush x:Key="AccentButtonForegroundBrush"             Color="{StaticResource OnAccentSolidColor}"/>
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOverBrush"  Color="{StaticResource OnAccentSolidColor}"/>
    <SolidColorBrush x:Key="AccentButtonForegroundPressedBrush"      Color="{StaticResource OnAccentSolidColor}"/>
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor"      Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="ProgressRingForeground"                  Color="{StaticResource AccentSolidColor}"/>

    <!-- 文本选中 / 列表选中：WPF 走 SystemColors，不覆盖出来是系统蓝。
         深色下的强调底本来就是深蓝（AccentSoft #34415B），配浅字读得清。 -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"           Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"       Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource InkColor}"/>

    <!-- 圆角：控件 8 / 浮层 12 -->
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

</ResourceDictionary>
