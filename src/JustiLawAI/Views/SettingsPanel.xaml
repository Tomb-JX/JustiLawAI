<UserControl x:Class="JustiLawAI.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="{StaticResource Sans}">

    <!--
        设置是一块压在窗口上的浮层，不是单独一个窗口：
        内容多高卡片就多高，顶到窗口边界之后由里面的 ScrollViewer 接管。
    -->

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Margin"     Value="0,0,0,7"/>
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource InkFaint}"/>
            <Setter Property="Margin"     Value="0,7,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource InkFaint}"/>
            <Setter Property="Margin"     Value="2,0,0,10"/>
        </Style>

        <!-- 设置左边那两条「模型 / 偏好」。自画模板，免得 WPF-UI 的默认外观带出强调蓝。 -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="FontSize"   Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Padding"    Value="12,7"/>
            <Setter Property="HorizontalAlignment"        Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="{StaticResource RMd}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FillHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Panel}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主题这类单选：一行一颗，圆点也是自画的。 -->
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="FontSize"   Value="13.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Row" Background="Transparent"
                                CornerRadius="{StaticResource RMd}"
                                Padding="10,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Dot" Grid.Column="0"
                                        Width="16" Height="16" CornerRadius="8"
                                        BorderBrush="{DynamicResource LineStrong}"
                                        BorderThickness="1.5" Background="Transparent"
                                        VerticalAlignment="Center">
                                    <Border x:Name="Core" Width="8" Height="8" CornerRadius="4"
                                            Background="{DynamicResource Ink}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="10,0,0,0"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Fill}"/>
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource InkSoft}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Fill}"/>
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource Ink}"/>
                                <Setter TargetName="Core" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Shell"
            Background="{DynamicResource Panel}"
            BorderBrush="{DynamicResource Line}"
            BorderThickness="1"
            CornerRadius="{StaticResource RXl}"
            MinWidth="420"
            MaxWidth="760"
            HorizontalAlignment="Stretch"
            MinHeight="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270"
                              Opacity="0.30" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题条 -->
            <Grid Grid.Row="0" Margin="24,16,14,6">
                <TextBlock Text="设置" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource MacIconButton}"
                        HorizontalAlignment="Right" Padding="6,5"
                        ToolTip="关闭"
                        AutomationProperties.AutomationId="CloseSettingsButton"
                        Click="OnCancel">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
                </Button>
            </Grid>

            <!-- 左边一条竖着的分栏（模型 / 偏好），右边是本页内容。 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="150" Padding="16,4,12,10"
                        BorderBrush="{DynamicResource Line}"
                        BorderThickness="0,0,1,0">
                    <StackPanel Orientation="Vertical">
                        <RadioButton x:Name="ModelTab" Style="{StaticResource Segment}"
                                     Content="模型" GroupName="SettingsPage"
                                     AutomationProperties.AutomationId="ModelPageTab"
                                     IsChecked="True" Checked="OnPageChanged"/>
                        <RadioButton x:Name="PrefsTab" Style="{StaticResource Segment}"
                                     Content="偏好" GroupName="SettingsPage"
                                     AutomationProperties.AutomationId="PreferencePageTab"
                                     Checked="OnPageChanged"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Column="1" Padding="0,4,24,10" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                    <!-- ================= 模型 ================= -->
                    <StackPanel x:Name="ModelPage">

                    <TextBlock Text="接口" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="接口地址" Style="{StaticResource FieldLabel}"/>
                            <ui:TextBox x:Name="BaseUrlBox"
                                        PlaceholderText="http://127.0.0.1:8000/v1"
                                        FontFamily="{StaticResource Mono}"/>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="OpenAI 兼容地址。本地服务常见写法：http://127.0.0.1:8000/v1"/>

                            <Border Height="16"/>

                            <TextBlock Text="API Key" Style="{StaticResource FieldLabel}"/>
                            <ui:TextBox x:Name="ApiKeyBox"
                                        PlaceholderText="本地接口通常留空"
                                        FontFamily="{StaticResource Mono}"/>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="本地接口通常留空。这里填的密钥会明文保存在本机配置文件里，只用于自己的机器。"/>

                            <Border Height="16"/>

                            <TextBlock Text="模型名" Style="{StaticResource FieldLabel}"/>
                            <ui:TextBox x:Name="ModelBox"
                                        PlaceholderText="例如 justilaw"
                                        FontFamily="{StaticResource Mono}"/>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="要填服务端真实的模型标识，不是服务名。填错了会在发送时报错，可以点下面的「测试连接」先确认。"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="系统提示词" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,18">
                        <StackPanel>
                            <ui:TextBox x:Name="PromptBox"
                                        Height="180"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        VerticalContentAlignment="Top"
                                        VerticalScrollBarVisibility="Auto"/>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="每次发送都会带上这段。要求材料没写明的一律写「材料未载明」，不要推测、也不要把没写当成零。"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="检查" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource CardAlt}" Padding="18,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="TestButton"
                                    Style="{StaticResource MacButton}"
                                    AutomationProperties.AutomationId="TestConnectionButton"
                                    Click="OnTestConnection">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="PlugConnected24" FontSize="13"/>
                                    <TextBlock Text="测试连接" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="TestResult" Margin="12,0,0,0"
                                       AutomationProperties.AutomationId="TestResultText"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource InkSoft}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    </StackPanel>

                    <!-- ================= 偏好 ================= -->
                    <StackPanel x:Name="PreferencePage" Visibility="Collapsed">

                        <TextBlock Text="主题" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Padding="10,8">
                            <StackPanel>
                                <RadioButton x:Name="ThemeDark" Style="{StaticResource Choice}"
                                             GroupName="ThemeChoice" Content="深色模式"
                                             AutomationProperties.AutomationId="ThemeDarkOption"
                                             Checked="OnThemeChanged"/>
                                <RadioButton x:Name="ThemeLight" Style="{StaticResource Choice}"
                                             GroupName="ThemeChoice" Content="浅色模式"
                                             AutomationProperties.AutomationId="ThemeLightOption"
                                             Checked="OnThemeChanged"/>
                                <RadioButton x:Name="ThemeSystem" Style="{StaticResource Choice}"
                                             GroupName="ThemeChoice" Content="跟随系统"
                                             AutomationProperties.AutomationId="ThemeSystemOption"
                                             Checked="OnThemeChanged"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="2,8,0,0"
                                   Text="只改这一台机器上的界面观感，和发给模型的内容没有关系。选完立刻能看见，点「保存」才会记住。"/>

                    </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource PanelAlt}"
                    BorderBrush="{DynamicResource Line}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11"
                    Padding="24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ErrorText" Grid.Column="0" FontSize="11.5"
                               VerticalAlignment="Center" Margin="0,0,14,0"
                               Foreground="{DynamicResource Danger}"
                               Visibility="Collapsed" TextWrapping="Wrap"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource MacButton}" Content="取消"
                                AutomationProperties.AutomationId="CancelSettingsButton" Click="OnCancel"/>
                        <Button Style="{StaticResource MacPrimaryButton}" Content="保存"
                                AutomationProperties.AutomationId="SaveSettingsButton"
                                Margin="10,0,0,0" IsDefault="True" Click="OnSave"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
