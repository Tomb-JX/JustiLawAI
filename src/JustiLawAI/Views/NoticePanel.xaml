<UserControl x:Class="JustiLawAI.Views.NoticePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="{StaticResource Sans}">

    <!--
        窗口内的提示 / 确认卡片。以前这些是 MessageBox——那会再开一个窗口，
        现在一律压在主窗口上。
    -->

    <Border Background="{DynamicResource Panel}"
            BorderBrush="{DynamicResource Line}"
            BorderThickness="1"
            CornerRadius="{StaticResource RXl}"
            MinWidth="360" MaxWidth="520">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270"
                              Opacity="0.30" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       AutomationProperties.AutomationId="NoticeTitle"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Ink}"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       FontSize="12.5"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Foreground="{DynamicResource InkSoft}"/>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button x:Name="CancelButton"
                        AutomationProperties.AutomationId="NoticeCancelButton"
                        Style="{StaticResource MacButton}"
                        Content="取消"
                        Click="OnCancel"/>
                <Button x:Name="ConfirmButton"
                        AutomationProperties.AutomationId="NoticeConfirmButton"
                        Style="{StaticResource MacPrimaryButton}"
                        Content="好"
                        IsDefault="True"
                        Margin="10,0,0,0"
                        Click="OnConfirm"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
