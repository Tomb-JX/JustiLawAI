<UserControl x:Class="JustiLawAI.Views.NewCasePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="{StaticResource Sans}">

    <!-- 新建案件：和设置一样压在主窗口上，不另开窗口。 -->

    <Border x:Name="Shell"
            Background="{DynamicResource Panel}"
            BorderBrush="{DynamicResource Line}"
            BorderThickness="1"
            CornerRadius="{StaticResource RXl}"
            MinWidth="392" MinHeight="0"
            MaxWidth="560">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270"
                              Opacity="0.30" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PromptText"
                       Grid.Row="0"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{DynamicResource Ink}"
                       Margin="0,0,0,10"/>

            <TextBox x:Name="ValueBox"
                     Grid.Row="1"
                     Style="{StaticResource Input}"
                     AutomationProperties.AutomationId="InputDialogBox"/>

            <TextBlock x:Name="ErrorText"
                       Grid.Row="2"
                       Text="名字不能为空。"
                       FontSize="12"
                       Foreground="{DynamicResource Danger}"
                       Margin="0,8,0,0"
                       Visibility="Collapsed"/>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Style="{StaticResource MacButton}" Content="取消" Click="OnCancel" IsCancel="True"/>
                <Button Style="{StaticResource MacPrimaryButton}" Content="确定" Click="OnOk"
                        IsDefault="True" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
