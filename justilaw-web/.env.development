# Mock 模式：true 时全部接口走内置 Mock（含 SSE 流式模拟）
# 后端（justilaw-api，端口 8000）运行时改为 false 走真实模型服务
VITE_USE_MOCK=false
# 真实后端接口地址（经 vite proxy 转发到 127.0.0.1:8000）
VITE_API_BASE_URL=/api/v1

# Logto 认证（SPA 应用的 App ID 属于公开信息，可入库）
VITE_LOGTO_ENDPOINT=https://oglnok.logto.app/
VITE_LOGTO_APP_ID=85gxcvhpmqa7l3h8fqz1h
# 后端 API Resource 标识（在 Logto Console › API resources 创建后填写；留空则请求不带 Authorization）
VITE_LOGTO_RESOURCE=
