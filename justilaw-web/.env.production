# 生产构建（公网 law.huanghaiyang.com 与 SSH 隧道访问共用此包）
# 同源部署：前端静态与 /api 反代在同一个域名/端口下，API 走相对路径
VITE_USE_MOCK=false
VITE_API_BASE_URL=/api/v1

# Logto 认证（SPA App ID 属公开信息；回调域名需在 Logto 控制台登记）
VITE_LOGTO_ENDPOINT=https://oglnok.logto.app/
VITE_LOGTO_APP_ID=85gxcvhpmqa7l3h8fqz1h
# 面向后端 API 的 Resource 标识：启用服务端鉴权后填写（与后端 LOGTO_API_RESOURCE 一致）
VITE_LOGTO_RESOURCE=
